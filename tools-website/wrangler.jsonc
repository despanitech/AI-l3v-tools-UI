{
  "name": "l3v-ai-tools",
  "main": "identity-worker.mjs",
  "account_id": "e59edf1b90c8e5d4194d739055828833",
  "compatibility_date": "2026-09-10",
  "workers_dev": false,
  "preview_urls": false,
  "ratelimits": [
    {"name":"VIDEO_ADMISSION_LIMITER","namespace_id":"20331","simple":{"limit":8,"period":60}},
    {"name":"VIDEO_POLL_LIMITER","namespace_id":"20332","simple":{"limit":60,"period":60}},
    {"name":"NAME_LOGO_LIMITER","namespace_id":"20333","simple":{"limit":8,"period":60}},
    {"name":"INVITATION_LIMITER","namespace_id":"20334","simple":{"limit":5,"period":60}}
  ],
  // Public Stripe product identifiers. The Worker resolves each to that
  // product's default price. Secrets (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET)
  // are set with `wrangler secret put` and are never committed.
  "vars": {
    "STRIPE_PRICE_CREATOR": "prod_VGkCE5W13sNS4G",
    "STRIPE_PRICE_STUDIO": "prod_VGkF4LVYuX77ch"
  },
  "kv_namespaces": [{"binding":"INVITATIONS","id":"09db05366a124ef3a3d05e217179a944"}],
  "routes": [{"pattern": "tools.l3v.ai", "custom_domain": true}],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/invite/*", "/api/invitation/validate", "/api/admin/invitations", "/api/account/work", "/api/name-logo/*", "/api/analyzer/config", "/api/analyze", "/api/first-frame", "/api/image-to-video", "/api/jobs", "/api/capacity-status"],

    "not_found_handling": "404-page"
  }
}

